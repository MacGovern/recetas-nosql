# Dirección de MongoDB. Con el servicio local por defecto no hace falta cambiarla.
MONGO_URI=mongodb://localhost:27017
# Nombre de la base de datos. El proyecto usa "recetario".
DB_NAME=recetario
# Puerto del servidor web. Si está ocupado, poner otro (por ejemplo 3001).
PORT=3000
# Texto secreto para firmar las cookies de sesión. Es solo un ejemplo: cambiarlo por uno largo y propio.
SESSION_SECRET=cambiar-por-un-texto-largo-y-secreto
